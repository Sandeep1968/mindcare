# Neon Postgres connection string
# Dashboard → your project → Connection details → Connection string (URI)
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Only needed if the client is ever served from a different origin than the API
# (e.g. a separate deployment or custom domain) — localhost:5173/4173 and any
# *.vercel.app origin are already allowed. Comma-separate multiple origins.
CLIENT_ORIGIN=

# Optional: seed practitioner on first migrate+seed
SEED_PRACTITIONER_NAME=Dr. Sarah Williams
SEED_PRACTITIONER_EMAIL=practitioner@mindcare.local
SEED_PRACTITIONER_PASSWORD=mindcare123

# Appointment emails (patient + therapist) with .ics calendar invite
# OPTIONAL — leave SMTP_HOST blank until real clinic email is ready.
# Without SMTP_HOST, confirmations are stored in the demo outbox (dashboard Settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_PASSWORD is accepted as an alias of SMTP_PASS (Gmail app password; spaces optional)
SMTP_FROM=MindCare Scheduling <noreply@yourclinic.com>
# Bug finder emails (comma-separated). Defaults already include the three developer inboxes.
BUG_REPORT_EMAIL=cseshivangi599@gmail.com,malhotra.05@gmail.com,ankit.malhotra97.am@gmail.com

# Therapist name → email (semicolon-separated). Fill when SMTP is live.
# Example: Dr. Sarah Williams=doctor@clinic.com;Dr. Emily Chen=emily@clinic.com
THERAPIST_EMAIL_MAP=
DEFAULT_THERAPIST_EMAIL=
CLINIC_NAME=MindCare Practice
CLINIC_ADDRESS=Clinic address on file
# Appointment wall-clock timezone (USA clinic default)
CLINIC_TZ=America/New_York

# Zoom dual-account meetings (doctor host + patient join)
# Create a Server-to-Server OAuth app at https://marketplace.zoom.us/
# Scopes: meeting:write:admin meeting:read:admin user:read:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=doctor@yourclinic.com


# Google Calendar subscribe feed token:
# /api/notifications/busy.ics?therapist=Dr.%20Sarah%20Williams&token=...
CLINIC_CALENDAR_TOKEN=mindcare-demo-calendar
